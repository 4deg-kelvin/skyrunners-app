# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
build/
next-env.d.ts

# production
dist/

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env*.local
.env.production

# typescript
*.tsbuildinfo

# vercel
.vercel

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# Local disk store — dev-only persistence, never committed (lib/store/disk.ts)
.data/

# Output of `npm run build:check` — kept separate so a build can never
# clobber a running dev server. Safe to delete.
.next-build/

# Editor swap files — a committed .swp is just a binary blob nobody can read
*.swp
*.swo

# Generated on demand by `npm run db:pending` — the set of unapplied
# migrations, which is true only at the moment it is written. APPLY_ALL.sql IS
# committed because it is the whole history and does not go stale; a committed
# PENDING.sql would be a file that lies about what the database needs.
supabase/PENDING.sql
