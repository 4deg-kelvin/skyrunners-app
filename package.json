{
  "name": "skyrunners-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "node scripts/build-check.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:pending": "node scripts/build-pending-bundle.mjs",
    "db:bundle": "node scripts/build-migration-bundle.mjs",
    "verify:live": "node --import ./scripts/alias-loader.mjs --experimental-strip-types scripts/verify-live.ts",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/alias-loader.mjs --experimental-strip-types --test \"lib/**/*.test.ts\"",
    "sweep": "node scripts/dead-controls.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run sweep && npm test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
