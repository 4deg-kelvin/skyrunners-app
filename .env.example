# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local     (PowerShell: copy .env.example .env.local)
#
# .env.local is gitignored. NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- Supabase (Phase 1) ----------------------------------------------------
# From your Supabase project: Settings -> API

# Safe to expose to the browser — but ONLY because Row Level Security decides what
# it can see. Migration 0004 must be applied, or this key reads the whole database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses all Row Level Security — treat it like a root password.
# Never prefix this with NEXT_PUBLIC_, or it ships to every visitor's browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Phase 1) ------------------------------------------------
# Configured in the Supabase dashboard, not here. Restrict the Google
# consent screen to the stanford.edu domain — that restriction IS the app's
# access control model.

# --- Email (Phase 4) -------------------------------------------------------
# resend.com -> API Keys
RESEND_API_KEY=
# Verified sender the club owns
EMAIL_FROM=

# --- Scheduled jobs (Phase 4) ----------------------------------------------
# Any long random string. Cron routes reject requests without it, so a stranger
# can't trigger the nightly jobs by hitting the URL.
CRON_SECRET=

# --- Local dev -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TEST-ENV:START — remove with `npm run remove:test-env`
# --- Test environment (local only) -----------------------------------------
# Set to 1 to get the persona switcher: browse the app as a Member, a Team Lead
# or a Co-Lead without creating accounts. Docs: lib/test-env/README.md
#
# Ignored unless the app is in demo mode, so it does nothing whatsoever once the
# Supabase keys above are filled in. That interlock is deliberate — identity
# spoofing and real data can never be on at the same time.
#
# Consequence worth knowing: to use the switcher you must comment OUT the
# Supabase keys above. You get one or the other, never both.
SKYRUNNERS_TEST_ENV=
# TEST-ENV:END
